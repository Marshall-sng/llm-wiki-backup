      "evidenceRefs": [
        "raw.pdf.fact.pageCount",
        "raw.pdf.fact.textOperatorCount",
        "raw.pdf.fact.imageCount",
        "raw.pdf.fact.scanLikely",
        "profile.style.0001"
      ],
