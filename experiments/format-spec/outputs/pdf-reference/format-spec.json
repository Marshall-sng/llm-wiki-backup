      "rule": "字体引用不是可编辑字体承诺。",
      "source": "detected",
      "target": "font-ref"
    },
    {
      "confidence": "medium",
      "detail": "扫描风险：未明显触发；扫描风险高时不得输出细排版规则。",
      "evidenceRefs": [
        "raw.pdf.fact.pageCount",
        "raw.pdf.fact.textOperatorCount",
        "raw.pdf.fact.imageCount",
        "raw.pdf.fact.scanLikely",
        "profile.style.0001"
      ],
