{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/experiments/format-profile/format-binding.schema.json",
  "title": "FormatBinding",
  "type": "object",
  "required": [
    "schemaVersion",
    "bindingId",
    "caseId",
    "mode",
    "profileId",
    "profileSnapshotHash",
    "overrides",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "format-binding.v0"
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "generate_from_profile",
        "adapt_draft_to_profile"
      ]
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileSnapshotHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "overrides": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostics.schema.json#/$defs/diagnostic"
      }
    }
  },
  "additionalProperties": true
}
