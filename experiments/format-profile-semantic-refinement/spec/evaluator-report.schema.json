{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/format-profile/evaluator-report.schema.json",
  "title": "Evaluator Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "verdict",
    "ruleResults",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "format-profile-evaluator-report.v0"
    },
    "caseId": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "ruleResults": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
