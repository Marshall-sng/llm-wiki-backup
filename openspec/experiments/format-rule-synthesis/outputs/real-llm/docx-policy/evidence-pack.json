    "sampleRules": [
      {
        "detail": "检测页尺寸约 21cm × 29.69cm；接近 A4 纵向时按正式文稿页面组织。",
        "id": "docx-page-1",
        "rule": "采用纵向成文页面规则。",
        "target": "page"
      },
      {
        "detail": "当前页边距探测值存在极端 twips 值时，不把它作为正式排版承诺；产品化时应显示为“边距证据不足/需人工确认”。",
        "id": "docx-page-2",
        "rule": "页边距只作为诊断线索。",
        "target": "page"
      },
      {
        "detail": "标题不复用来源文件题名；生成或适配时由用户底稿事实决定标题内容。建议居中或显著区分于正文。",
        "id": "docx-title-1",
        "rule": "主标题独立成行，表达文种和主题。",
